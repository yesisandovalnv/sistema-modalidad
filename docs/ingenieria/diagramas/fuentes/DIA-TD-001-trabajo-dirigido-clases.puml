@startuml DIA-TD-001-trabajo-dirigido-clases
' ID: DIA-TD-001
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de trabajo-dirigido
' Alcance y elementos: TrabajoDirigidoExpediente, InformeSeguimientoTrabajoDirigido
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/modalidades/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-TD-001 — Clases de dominio: trabajo-dirigido
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "TrabajoDirigidoExpediente" as TrabajoDirigidoExpediente <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion : OneToOneField <<FK>> <<UQ>>
  tipo_ejecucion : CharField
  institucion_nombre : CharField
  institucion_tipo : CharField
  constituida_legalmente : BooleanField
  actividad_permanente : BooleanField
  +clean()
  +save(*args, **kwargs)
}
class "InformeSeguimientoTrabajoDirigido" as InformeSeguimientoTrabajoDirigido <<entidad>> {
  id : BigAutoField <<PK derivada>>
  expediente : ForeignKey <<FK>>
  registrado_por : ForeignKey <<FK>>
  periodo : CharField
  descripcion_desempeno : TextField
  evaluacion_cualitativa : TextField
  aporte_laboral : TextField
  sugerencias_recomendaciones : TextField
  +save(*args, **kwargs)
}
class "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
class "Postulacion" as Postulacion <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
TrabajoDirigidoExpediente "0..1" -- "1" Postulacion : postulacion
InformeSeguimientoTrabajoDirigido "0..*" -- "1" TrabajoDirigidoExpediente : expediente
InformeSeguimientoTrabajoDirigido "0..*" -- "1" CustomUser : registrado_por
@enduml
