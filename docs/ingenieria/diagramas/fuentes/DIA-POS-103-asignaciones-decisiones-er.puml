endlegend
left to right direction
entity "AsignacionPostulacion" as AsignacionPostulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  usuario_id : ForeignKey <<FK>>
  designado_por_id : ForeignKey <<FK>> <<NULL>>
  seguimiento_etapa_id : ForeignKey <<FK>> <<NULL>>
  tipo_participacion : CharField
  orden_cargo : PositiveIntegerField <<NULL>>
  fecha_designacion : DateTimeField
  fecha_finalizacion : DateTimeField <<NULL>>
  observaciones : TextField
}
entity "DecisionAcademicaEtapa" as DecisionAcademicaEtapa <<entidad>> {
  id : BigAutoField <<PK derivada>>
  seguimiento_etapa_id : ForeignKey <<FK>>
  registrado_por_id : ForeignKey <<FK>>
  codigo : CharField
  resultado : CharField
  fecha_decision : DateTimeField
  observaciones : TextField
}
entity "ParticipacionDecisionAcademica" as ParticipacionDecisionAcademica <<entidad>> {
  id : BigAutoField <<PK derivada>>
  decision_id : ForeignKey <<FK>>
  asignacion_id : ForeignKey <<FK>>
  rol : CharField
  orden : PositiveIntegerField <<NULL>>
}
entity "PublicacionMemorandumDesignacion" as PublicacionMemorandumDesignacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  seguimiento_etapa_id : ForeignKey <<FK>>
  version_documento_id : OneToOneField <<FK>> <<UQ>>
  asignaciones : ManyToManyField <<M2M>>
  publicado_por_id : ForeignKey <<FK>>
  fecha_publicacion : DateTimeField
}
entity "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "Postulacion" as Postulacion <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "SeguimientoEtapa" as SeguimientoEtapa <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "VersionDocumento" as VersionDocumento <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
