!include ../estilos/base.puml.inc
title DIA-POS-004 — Clases de dominio: condiciones-entregas
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "CondicionPostulacion" as CondicionPostulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion : ForeignKey <<FK>>
  verificado_por : ForeignKey <<FK>> <<NULL>>
  codigo : CharField
  nombre : CharField
  tipo : CharField
  estado : CharField
  fecha_verificacion : DateTimeField <<NULL>>
  +clean()
  +save(*args, **kwargs)
}
class "EntregaFisica" as EntregaFisica <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion : ForeignKey <<FK>>
  recibido_por : ForeignKey <<FK>> <<NULL>>
  codigo : CharField
  nombre : CharField
  cantidad : PositiveIntegerField <<NULL>>
  cantidad_recibida : PositiveIntegerField
  estado : CharField
  +clean()
  +save(*args, **kwargs)
}
class "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
class "Postulacion" as Postulacion <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
CondicionPostulacion "0..*" -- "1" Postulacion : postulacion
CondicionPostulacion "0..*" -- "0..1" CustomUser : verificado_por
EntregaFisica "0..*" -- "1" Postulacion : postulacion
EntregaFisica "0..*" -- "0..1" CustomUser : recibido_por
@enduml
