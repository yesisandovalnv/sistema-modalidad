  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "DiplomadoRequisitosPolicy" as DiplomadoRequisitosPolicy <<politica>> {
  +get_documentos_requeridos(fase)
}
class "DiplomadoEventoPolicy" as DiplomadoEventoPolicy <<politica>> {
  EVENT_STAGE
  +get_tipos_evento()
  +get_etapa_asociada(tipo_evento)
  +validar_correspondencia_evento_etapa(evento)
  +validar_programacion(seguimiento, asignaciones, **kwargs)
  +validar_participante(evento, asignacion, rol_evento, **kwargs)
  +validar_quorum(evento)
}
class "DiplomadoEvaluacionPolicy" as DiplomadoEvaluacionPolicy <<politica>> {
  +get_tipos_evaluacion()
  +get_modalidad_registro_por_defecto(evento, tipo)
  +validar_solicitud_registro(modalidad_registro, evaluador, evento, **kwargs)
  +validar_registro(evaluacion)
  +get_valores_registro(evento, tipo, nota)
  +obtener_evaluacion_para_consolidar(evaluaciones, **kwargs)
}
class "DiplomadoPolicy" as DiplomadoPolicy <<politica>> {
  codigo
  etapas
  evento_policy
  evaluacion_policy
  +get_reglas_asignacion()
  +get_configuracion_actores(postulacion, seguimiento)
  +get_cierre_policy()
  +usa_conclusion_academica_propia()
  +get_orientacion_etapa_actual(postulacion, seguimiento)
  +validar_inicio_etapa(seguimiento)
}
class "BaseRequisitosPolicy" as BaseRequisitosPolicy <<referencia>> {
}
class "BaseEventoPolicy" as BaseEventoPolicy <<referencia>> {
}
class "BaseEvaluacionPolicy" as BaseEvaluacionPolicy <<referencia>> {
}
class "BaseModalidadPolicy" as BaseModalidadPolicy <<referencia>> {
}
BaseRequisitosPolicy <|-- DiplomadoRequisitosPolicy
BaseEventoPolicy <|-- DiplomadoEventoPolicy
BaseEvaluacionPolicy <|-- DiplomadoEvaluacionPolicy
BaseModalidadPolicy <|-- DiplomadoPolicy
DiplomadoPolicy --> DiplomadoEventoPolicy : evento_policy
DiplomadoPolicy --> DiplomadoEvaluacionPolicy : evaluacion_policy
DiplomadoPolicy --> DiplomadoRequisitosPolicy : requisitos_policy
@enduml
