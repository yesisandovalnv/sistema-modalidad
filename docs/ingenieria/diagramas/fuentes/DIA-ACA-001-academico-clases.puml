@startuml DIA-ACA-001-academico-clases
' ID: DIA-ACA-001
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de academico
' Alcance y elementos: Periodo, Modalidad, DocumentoOficialModalidad, EtapaModalidad, Requisito, ModalidadRequisito
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/academico/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-ACA-001 — Clases de dominio: academico
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "Periodo" as Periodo <<entidad>> {
  id : BigAutoField <<PK derivada>>
  nombre : CharField <<UQ>>
  fecha_inicio : DateField
  fecha_fin : DateField
  gestion : PositiveSmallIntegerField
  semestre : CharField
  +clean()
  +save(*args, **kwargs)
}
class "Modalidad" as Modalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
}
class "DocumentoOficialModalidad" as DocumentoOficialModalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad : ForeignKey <<FK>>
  actualizado_por : ForeignKey <<FK>>
  archivo : FileField
  nombre : CharField
}
class "EtapaModalidad" as EtapaModalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad : ForeignKey <<FK>>
  codigo : CharField
  nombre : CharField
  orden : PositiveIntegerField
  obligatoria : BooleanField
  permite_repeticion : BooleanField
  +clean()
  +save(*args, **kwargs)
}
class "Requisito" as Requisito <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField
  descripcion : TextField <<NULL>>
  obligatorio : BooleanField
}
class "ModalidadRequisito" as ModalidadRequisito <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad : ForeignKey <<FK>>
  requisito : ForeignKey <<FK>>
  orden : PositiveIntegerField
  +clean()
  +save(*args, **kwargs)
}
class "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
DocumentoOficialModalidad "0..*" -- "1" Modalidad : modalidad
DocumentoOficialModalidad "0..*" -- "1" CustomUser : actualizado_por
EtapaModalidad "0..*" -- "1" Modalidad : modalidad
ModalidadRequisito "0..*" -- "1" Modalidad : modalidad
ModalidadRequisito "0..*" -- "1" Requisito : requisito
@enduml
