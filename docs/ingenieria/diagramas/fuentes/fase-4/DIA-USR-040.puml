  usecase "UC-USR-003\nRenovar tokens JWT" as UC_USR_003
  usecase "UC-USR-004\nCerrar sesión" as UC_USR_004
  usecase "UC-USR-005\nConsultar perfil y capacidades\npropias" as UC_USR_005
  usecase "UC-USR-006\nAdministrar roles" as UC_USR_006
  usecase "UC-USR-009\nIniciar sesión estudiantil con\nR.U. y C.I." as UC_USR_009
}
ACT_SYS_001 -- UC_USR_001
ACT_USR_001 -- UC_USR_002
ACT_SYS_001 -- UC_USR_003
ACT_SYS_002 -- UC_USR_004
ACT_SYS_002 -- UC_USR_005
ACT_USR_001 -- UC_USR_006
ACT_SYS_001 -- UC_USR_009
