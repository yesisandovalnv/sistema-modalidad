!include ../../estilos/base.puml.inc
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #EFF6FF
skinparam actorStyle awesome
title DIA-POS-044 — Condiciones y entrega física
actor "Propietario de\npostulación" as ACT_POS_001
actor "Usuario vinculado al\nexpediente" as ACT_POS_002
actor "Administración\nfuncional" as ACT_USR_001
rectangle "Sistema de Modalidades de Graduación\nCondiciones y entrega física" {
  usecase "UC-POS-023\nVerificar condiciones\ncomplementarias" as UC_POS_023
