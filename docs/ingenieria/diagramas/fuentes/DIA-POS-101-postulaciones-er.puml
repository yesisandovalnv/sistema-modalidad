@startuml DIA-POS-101-postulaciones-er
' ID: DIA-POS-101
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de postulaciones
' Alcance y elementos: EstadoPostulacion, Postulacion, HistorialEstado, Observacion
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/postulantes/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-POS-101 — ER lógico: postulaciones
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
entity "EstadoPostulacion" as EstadoPostulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
}
entity "Postulacion" as Postulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  estudiante_id : ForeignKey <<FK>>
  modalidad_id : ForeignKey <<FK>>
  periodo_id : ForeignKey <<FK>>
  estado_actual_id : ForeignKey <<FK>> <<NULL>>
  baja_por_id : ForeignKey <<FK>> <<NULL>>
  codigo : CharField <<UQ>>
  fecha_postulacion : DateTimeField
  observaciones_generales : TextField <<NULL>>
  vigencia : CharField
  tipo_registro : CharField
}
entity "HistorialEstado" as HistorialEstado <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  estado_anterior_id : ForeignKey <<FK>> <<NULL>>
  estado_nuevo_id : ForeignKey <<FK>>
  usuario_id : ForeignKey <<FK>>
  fecha_cambio : DateTimeField
  comentario : TextField <<NULL>>
}
entity "Observacion" as Observacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  usuario_id : ForeignKey <<FK>>
  comentario : TextField
  leida_estudiante : BooleanField
  fecha_observacion : DateTimeField
}
entity "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "Modalidad" as Modalidad <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "Periodo" as Periodo <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
Postulacion }o--|| CustomUser : estudiante
Postulacion }o--|| Modalidad : modalidad
Postulacion }o--|| Periodo : periodo
Postulacion }o--o| EstadoPostulacion : estado_actual
Postulacion }o--o| CustomUser : baja_por
HistorialEstado }o--|| Postulacion : postulacion
HistorialEstado }o--o| EstadoPostulacion : estado_anterior
HistorialEstado }o--|| EstadoPostulacion : estado_nuevo
HistorialEstado }o--|| CustomUser : usuario
Observacion }o--|| Postulacion : postulacion
Observacion }o--|| CustomUser : usuario
note bottom of Postulacion
Restricciones seleccionadas de Meta:
UQ(estudiante)
condicional; no equivale a UQ global
end note
@enduml
