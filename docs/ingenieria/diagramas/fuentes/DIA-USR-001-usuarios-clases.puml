@startuml DIA-USR-001-usuarios-clases
' ID: DIA-USR-001
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de usuarios
' Alcance y elementos: Role, CustomUser, AuditLog, StudentLoginThrottle
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False. Campos y M2M heredados de AbstractUser se separan en la vista de autenticación.
' Fuente: apps/usuarios/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-USR-001 — Clases de dominio: usuarios
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "Role" as Role <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField
  descripcion : TextField <<NULL>>
}
class "CustomUser" as CustomUser <<entidad>> {
  id : BigAutoField <<PK derivada>>
  role : ForeignKey <<FK>> <<NULL>>
  nombres : CharField
  apellido_paterno : CharField
  apellido_materno : CharField
  ci : CharField <<UQ>> <<NULL>>
  expedido : CharField
  +nombre_completo()
}
class "AuditLog" as AuditLog <<entidad>> {
  id : BigAutoField <<PK derivada>>
  usuario : ForeignKey <<FK>>
  accion : CharField
  modulo : CharField
  descripcion : TextField
  ip_address : GenericIPAddressField <<NULL>>
  metodo_http : CharField
}
class "StudentLoginThrottle" as StudentLoginThrottle <<entidad>> {
  id : BigAutoField <<PK derivada>>
  scope : CharField
  key_digest : CharField
  failed_attempts : PositiveSmallIntegerField
  window_started_at : DateTimeField <<NULL>>
  blocked_until : DateTimeField <<NULL>>
}
CustomUser "0..*" -- "0..1" Role : role
AuditLog "0..*" -- "1" CustomUser : usuario
@enduml
