@startuml DIA-DOC-020-servicios-documentales
' ID: DIA-DOC-020
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Separar servicios, entrada API y políticas; solo operaciones verificadas
' Alcance y elementos: DocumentoService, ConfirmacionCorreccionDocumentoService
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Operaciones seleccionadas de las declaradas en código; no representa toda la API pública ni secuencia de ejecución. Referencias externas abreviadas. Herencia explícita en AST; asociaciones por instanciación en atributos y dependencias por anotación de tipo. No se presume igualdad académica por herencia.
' Fuente: apps/documentos/services.py
!include ../estilos/base.puml.inc
title DIA-DOC-020 — Clases: servicios-documentales
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "DocumentoService" as DocumentoService <<servicio>> {
  +obtener_capacidad_carga(postulacion, tipo_documento, usuario, documento, policy)
  +obtener_tipos_documentales_historicos(modalidad)
  +subir_documento(postulacion, tipo_documento, archivo, usuario, evento_defensa, request)
  +subir_documento_historico(postulacion, tipo_documento, archivo, usuario, request)
  +crear_nueva_version(documento, archivo, usuario, request, allow_historic, autoaprobar_carga_inicial)
  +aprobar_documento(documento, usuario, comentario, request)
}
class "ConfirmacionCorreccionDocumentoService" as ConfirmacionCorreccionDocumentoService <<servicio>> {
  +registrar(postulacion, evento_origen, version_observada, version_corregida, confirmado_por, asignacion_confirmante, observaciones)
}
@enduml
