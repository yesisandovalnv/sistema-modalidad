@startuml DIA-POS-021-servicios-defensa-cierre
' ID: DIA-POS-021
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Separar servicios, entrada API y políticas; solo operaciones verificadas
' Alcance y elementos: ProyectoGradoCierrePolicy, CierrePostulacionService, EventoDefensaService, EvaluacionDefensaService
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Operaciones seleccionadas de las declaradas en código; no representa toda la API pública ni secuencia de ejecución. Referencias externas abreviadas. Herencia explícita en AST; asociaciones por instanciación en atributos y dependencias por anotación de tipo. No se presume igualdad académica por herencia.
' Fuente: apps/modalidades/policies.py
' Fuente: apps/postulantes/cierre.py
' Fuente: apps/postulantes/defensas.py
!include ../estilos/base.puml.inc
title DIA-POS-021 — Clases: servicios-defensa-cierre
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "ProyectoGradoCierrePolicy" as ProyectoGradoCierrePolicy <<politica>> {
  CONDITION_CODES
  DELIVERY_CODES
  FINAL_DOCUMENT_CODES
  REVIEW_DOCUMENT_CODES
  +inicializar_requisitos(post)
  +evaluar_revision_final(post)
  +evaluar_cierre_documental(post)
  +obtener_faltantes_revision_final(p)
  +obtener_faltantes_cierre(p)
  +puede_aprobar_revision_final(p)
  +puede_concluir(p)
}
class "CierrePostulacionService" as CierrePostulacionService <<servicio>> {
  +consultar_estado_cierre(postulacion, usuario, auditar)
  +aprobar_revision_final(postulacion, usuario, observaciones)
  +aprobar_cierre_documental(postulacion, usuario, observaciones)
  +concluir_postulacion(postulacion, usuario, observaciones)
  +reabrir_cierre(postulacion, usuario, motivo)
}
class "EventoDefensaService" as EventoDefensaService <<servicio>> {
  +programar_evento(postulacion, seguimiento_etapa, tipo_evento, fecha_programada, usuario, lugar, modalidad_evento, enlace_virtual, observaciones)
  +agregar_participante(evento, asignacion, rol_evento, usuario)
  +remover_participante(evento, participante, usuario)
  +iniciar_evento(evento, usuario)
  +iniciar_evento_con_asistencia(evento, usuario, asistencias)
  +registrar_asistencia(participante, presente, usuario, observaciones)
  +suspender_evento(evento, usuario, motivo)
  +cancelar_evento(evento, usuario, motivo)
}
class "EvaluacionDefensaService" as EvaluacionDefensaService <<servicio>> {
  +consolidar_evaluacion_evento(evento, usuario)
  +calcular_resultado_final(postulacion, usuario, auditar)
  +registrar_evaluacion_perfil(evento, usuario, resultado, evaluador, modalidad_registro, observaciones)
  +registrar_evaluacion_tematica(evento, usuario, resultado, evaluador, modalidad_registro, observaciones)
  +registrar_evaluacion_privada(evento, usuario, resultado, nota, evaluador, modalidad_registro, observaciones, semantica_nota)
  +registrar_evaluacion_publica(evento, usuario, nota, evaluador, modalidad_registro, observaciones, semantica_nota)
}
class "BaseCierrePolicy" as BaseCierrePolicy <<referencia>> {
}
BaseCierrePolicy <|-- ProyectoGradoCierrePolicy
@enduml
