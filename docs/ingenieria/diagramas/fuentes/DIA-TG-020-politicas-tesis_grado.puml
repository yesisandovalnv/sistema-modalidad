class "TesisGradoEventoPolicy" as TesisGradoEventoPolicy <<politica>> {
  PUBLIC_REQUIRED_ACTORS
  EVENT_STAGE
  +public_actor_requirements(asignaciones)
  +get_tipos_evento()
  +get_etapa_asociada(tipo_evento)
  +validar_correspondencia_evento_etapa(evento)
  +validar_programacion(tipo_evento, seguimiento, fecha_programada, **kwargs)
  +validar_participante(evento, asignacion, rol_evento, **kwargs)
}
class "TesisGradoEvaluacionPolicy" as TesisGradoEvaluacionPolicy <<politica>> {
  +get_tipos_evaluacion()
  +get_configuracion_numerica(tipo)
  +admite_semantica_entrada(evento, tipo, semantica)
  +get_modalidad_registro_por_defecto(evento, tipo)
  +validar_solicitud_registro(modalidad_registro, evaluador, **kwargs)
  +validar_registro(evaluacion)
}
class "TesisGradoRequisitosPolicy" as TesisGradoRequisitosPolicy <<politica>> {
  INSCRIPCION_DOCUMENTS
  DOCUMENTS_BY_STAGE
  +get_documentos_requeridos(fase)
}
class "TesisGradoPolicy" as TesisGradoPolicy <<politica>> {
  codigo
  etapas
  evento_policy
  evaluacion_policy
  +resolver_contexto_documental(postulacion)
  +get_orientacion_etapa_actual(postulacion, seguimiento)
  +get_reglas_asignacion()
  +get_configuracion_actores(postulacion, seguimiento)
  +validar_asignacion(queryset_contexto, postulacion, tipo_participacion, seguimiento_etapa, orden_cargo, **kwargs)
  +validar_nuevo_intento(etapa, ultimo_seguimiento, **kwargs)
}
