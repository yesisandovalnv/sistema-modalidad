@startuml DIA-DOC-101-documentos-versiones-er
' ID: DIA-DOC-101
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de documentos-versiones
' Alcance y elementos: EstadoDocumento, TipoDocumento, DocumentoPostulacion, VersionDocumento
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/documentos/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-DOC-101 — ER lógico: documentos-versiones
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
entity "EstadoDocumento" as EstadoDocumento <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
}
entity "TipoDocumento" as TipoDocumento <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
  obligatorio : BooleanField
  permite_multiple_version : BooleanField
}
entity "DocumentoPostulacion" as DocumentoPostulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  evento_defensa_id : ForeignKey <<FK>> <<NULL>>
  tipo_documento_id : ForeignKey <<FK>>
  estado_id : ForeignKey <<FK>>
  fecha_subida : DateTimeField
  fecha_revision : DateTimeField <<NULL>>
  observacion_general : TextField <<NULL>>
  requiere_correccion : BooleanField
}
entity "VersionDocumento" as VersionDocumento <<entidad>> {
  id : BigAutoField <<PK derivada>>
  documento_id : ForeignKey <<FK>>
  subido_por_id : ForeignKey <<FK>>
  numero_version : PositiveIntegerField
  archivo : FileField
  nombre_original : CharField
  tamano_bytes : BigIntegerField
  hash_sha256 : CharField
}
entity "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "EventoDefensa" as EventoDefensa <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "Postulacion" as Postulacion <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
DocumentoPostulacion }o--|| Postulacion : postulacion
DocumentoPostulacion }o--o| EventoDefensa : evento_defensa
DocumentoPostulacion }o--|| TipoDocumento : tipo_documento
DocumentoPostulacion }o--|| EstadoDocumento : estado
VersionDocumento }o--|| DocumentoPostulacion : documento
VersionDocumento }o--|| CustomUser : subido_por
note bottom of DocumentoPostulacion
Restricciones seleccionadas de Meta:
UQ(postulacion, tipo_documento)
end note
note bottom of VersionDocumento
Restricciones seleccionadas de Meta:
UQ(documento, numero_version)
end note
@enduml
