@startuml DIA-ACA-101-academico-er
' ID: DIA-ACA-101
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de academico
' Alcance y elementos: Periodo, Modalidad, DocumentoOficialModalidad, EtapaModalidad, Requisito, ModalidadRequisito
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/academico/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-ACA-101 — ER lógico: academico
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
entity "Periodo" as Periodo <<entidad>> {
  id : BigAutoField <<PK derivada>>
  nombre : CharField <<UQ>>
  fecha_inicio : DateField
  fecha_fin : DateField
  gestion : PositiveSmallIntegerField
  semestre : CharField
}
entity "Modalidad" as Modalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
}
entity "DocumentoOficialModalidad" as DocumentoOficialModalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad_id : ForeignKey <<FK>>
  actualizado_por_id : ForeignKey <<FK>>
  archivo : FileField
  nombre : CharField
}
entity "EtapaModalidad" as EtapaModalidad <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad_id : ForeignKey <<FK>>
  codigo : CharField
  nombre : CharField
  orden : PositiveIntegerField
  obligatoria : BooleanField
  permite_repeticion : BooleanField
}
entity "Requisito" as Requisito <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField
  descripcion : TextField <<NULL>>
  obligatorio : BooleanField
}
entity "ModalidadRequisito" as ModalidadRequisito <<entidad>> {
  id : BigAutoField <<PK derivada>>
  modalidad_id : ForeignKey <<FK>>
  requisito_id : ForeignKey <<FK>>
  orden : PositiveIntegerField
}
entity "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
DocumentoOficialModalidad }o--|| Modalidad : modalidad
DocumentoOficialModalidad }o--|| CustomUser : actualizado_por
EtapaModalidad }o--|| Modalidad : modalidad
ModalidadRequisito }o--|| Modalidad : modalidad
ModalidadRequisito }o--|| Requisito : requisito
note bottom of Periodo
Restricciones seleccionadas de Meta:
UQ(gestion, semestre)
end note
note bottom of EtapaModalidad
Restricciones seleccionadas de Meta:
UQ(modalidad, codigo)
UQ(modalidad, orden)
Más restricciones: ver diccionario completo.
end note
note bottom of ModalidadRequisito
Restricciones seleccionadas de Meta:
UQ(modalidad, requisito)
end note
@enduml
