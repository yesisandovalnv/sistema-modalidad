@startuml DIA-EG-101-examen-er
' ID: DIA-EG-101
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de examen
' Alcance y elementos: ExamenArea, ExamenEvaluacion
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/modalidades/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilos/base.puml.inc
title DIA-EG-101 — ER lógico: examen
footer 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
entity "ExamenArea" as ExamenArea <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion_id : ForeignKey <<FK>>
  codigo : CharField
  nombre : CharField
  orden : PositiveSmallIntegerField
  ponderacion : DecimalField
  estado : CharField
}
entity "ExamenEvaluacion" as ExamenEvaluacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  area_id : ForeignKey <<FK>>
  evaluador_id : ForeignKey <<FK>> <<NULL>>
  intento : PositiveSmallIntegerField
  nota : DecimalField
  resultado : CharField
  modalidad_registro : CharField
  fecha_evaluacion : DateTimeField
}
entity "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
entity "Postulacion" as Postulacion <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
ExamenArea }o--|| Postulacion : postulacion
ExamenEvaluacion }o--|| ExamenArea : area
ExamenEvaluacion }o--o| CustomUser : evaluador
note bottom of ExamenArea
Restricciones seleccionadas de Meta:
UQ(postulacion, codigo)
UQ(postulacion, orden)
end note
note bottom of ExamenEvaluacion
Restricciones seleccionadas de Meta:
UQ(area, intento, evaluador)
end note
@enduml
