@startuml ACA-08--DIA-POS-001
' Adaptación académica ACA-08; original DIA-POS-001; fase 9
' ID: DIA-POS-001
' Fecha: 2026-11-01 America/La_Paz
' Objetivo: Mostrar entidades, relaciones y opcionalidad de postulaciones
' Alcance y elementos: EstadoPostulacion, Postulacion, HistorialEstado, Observacion
' Version: 689eeb56ac6f / desarrollo / directorio de trabajo
' Limitaciones: Vista lógica, no esquema instalado. PK id derivada de DEFAULT_AUTO_FIELD; campos comunes heredados y atributos escalares no mostrados se detallan en el diccionario. Referencias externas abreviadas. Cardinalidades estructurales por null/OneToOne/unique; restricciones condicionales y clean no alteran esos máximos. No se afirma composición UML ni obligatoriedad de colección M2M por blank=False.
' Fuente: apps/postulantes/models.py
' Fuente: core/models.py
' Fuente: core/settings/base.py
!include ../estilo-academico.puml.inc
title Figura 08 — DIA-POS-001 — Clases de dominio: postulaciones
footer Referencia técnica: 689eeb56ac6f / desarrollo / directorio de trabajo | lógico derivado del código / infraestructura declarada
legend bottom left
  Referencia externa = definición abreviada; no duplica entidad.
  No se ha inspeccionado PostgreSQL ni el despliegue en ejecución.
endlegend
left to right direction
class "EstadoPostulacion" as EstadoPostulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  codigo : CharField <<UQ>>
  nombre : CharField <<UQ>>
  descripcion : TextField <<NULL>>
}
class "Postulacion" as Postulacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  estudiante : ForeignKey <<FK>>
  modalidad : ForeignKey <<FK>>
  periodo : ForeignKey <<FK>>
  estado_actual : ForeignKey <<FK>> <<NULL>>
  baja_por : ForeignKey <<FK>> <<NULL>>
  codigo : CharField <<UQ>>
  fecha_postulacion : DateTimeField
  observaciones_generales : TextField <<NULL>>
  vigencia : CharField
  tipo_registro : CharField
  +save(*args, **kwargs)
}
class "HistorialEstado" as HistorialEstado <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion : ForeignKey <<FK>>
  estado_anterior : ForeignKey <<FK>> <<NULL>>
  estado_nuevo : ForeignKey <<FK>>
  usuario : ForeignKey <<FK>>
  fecha_cambio : DateTimeField
  comentario : TextField <<NULL>>
}
class "Observacion" as Observacion <<entidad>> {
  id : BigAutoField <<PK derivada>>
  postulacion : ForeignKey <<FK>>
  usuario : ForeignKey <<FK>>
  comentario : TextField
  leida_estudiante : BooleanField
  fecha_observacion : DateTimeField
}
class "CustomUser" as CustomUser <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
class "Modalidad" as Modalidad <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
class "Periodo" as Periodo <<referencia>> {
  id : BigAutoField <<PK derivada>>
}
Postulacion "0..*" -- "1" CustomUser : estudiante
Postulacion "0..*" -- "1" Modalidad : modalidad
Postulacion "0..*" -- "1" Periodo : periodo
Postulacion "0..*" -- "0..1" EstadoPostulacion : estado_actual
Postulacion "0..*" -- "0..1" CustomUser : baja_por
HistorialEstado "0..*" -- "1" Postulacion : postulacion
HistorialEstado "0..*" -- "0..1" EstadoPostulacion : estado_anterior
HistorialEstado "0..*" -- "1" EstadoPostulacion : estado_nuevo
HistorialEstado "0..*" -- "1" CustomUser : usuario
Observacion "0..*" -- "1" Postulacion : postulacion
Observacion "0..*" -- "1" CustomUser : usuario
@enduml
