  usecase "UC-REP-001\nConsultar resultados académicos\ninstitucionales" as UC_REP_001
  usecase "UC-ACA-005\nConsultar modalidades y\ncapacidades" as UC_ACA_005
}
ACT_SYS_001 -- UC_USR_001
ACT_USR_001 -- UC_POS_002
ACT_USR_002 -- UC_POS_002
ACT_USR_003 -- UC_POS_002
ACT_USR_001 -- UC_POS_003
ACT_USR_001 -- UC_DOC_001
ACT_POS_001 -- UC_DOC_001
ACT_USR_001 -- UC_POS_006
ACT_SYS_002 -- UC_NOT_001
ACT_USR_001 -- UC_REP_001
ACT_USR_003 -- UC_REP_001
