!include ../estilo-academico.puml.inc
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #EFF6FF
skinparam actorStyle awesome
title Figura 01 — DIA-SYS-001 — Vista general del sistema
actor "Propietario de\npostulación" as ACT_POS_001
actor "Usuario vinculado al\nexpediente" as ACT_POS_002
actor "Solicitante de acceso" as ACT_SYS_001
actor "Usuario autenticado" as ACT_SYS_002
actor "Administración\nfuncional" as ACT_USR_001
actor "Estudiante" as ACT_USR_002
actor "Docente" as ACT_USR_003
ACT_POS_001 --|> ACT_SYS_002
ACT_POS_002 --|> ACT_SYS_002
ACT_USR_001 --|> ACT_SYS_002
ACT_USR_002 --|> ACT_SYS_002
ACT_USR_003 --|> ACT_SYS_002
rectangle "Sistema de Modalidades de\nGraduación\nVista general del sistema" {
  usecase "UC-USR-001\nIniciar sesión con usuario y\ncontraseña" as UC_USR_001
  usecase "UC-POS-002\nConsultar postulaciones y\nexpediente" as UC_POS_002
  usecase "UC-POS-003\nEjecutar una transición de etapa" as UC_POS_003
  usecase "UC-DOC-001\nCargar un documento o una nueva\nversión" as UC_DOC_001
  usecase "UC-POS-006\nAdministrar el ciclo de una\ndefensa" as UC_POS_006
