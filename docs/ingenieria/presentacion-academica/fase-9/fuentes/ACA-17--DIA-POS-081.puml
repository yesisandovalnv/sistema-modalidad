s0 --> s1 : T02 iniciar_etapa\n[G02] / A02
s1 --> s2 : T03 observar_etapa\n[G03] / A03
s1 --> s3 : T04 aprobar_etapa\n[G04] / A04
s1 --> s4 : T05 rechazar_etapa\n[G05] / A05
s2 --> s3 : T06 aprobar_etapa\n[G06] / A06
s2 --> s4 : T07 rechazar_etapa\n[G07] / A07
